# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (Required for Milestone 2+)
# ─────────────────────────────────────────────────────────────────────────────
# Find these in your Supabase project dashboard:
#   Settings → API → Project URL + anon/public key
#
# NEXT_PUBLIC_* values are safe to expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY must NEVER be exposed to the browser or committed.
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — only for server-side admin operations (not used in M2).
# Keep this secret. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────────────
# RAZORPAY TEST MODE (Configured in Milestone 4)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─────────────────────────────────────────────────────────────────────────────
# AI SERVICE (Configured in Milestone 5+)
# ─────────────────────────────────────────────────────────────────────────────
USE_REAL_ML_SERVICE=false
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_URL=

# ─────────────────────────────────────────────────────────────────────────────
# STORAGE — Cloudinary (Configured in Milestone 3)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
